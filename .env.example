# ── Required for answers ────────────────────────────────────────────────
# Anthropic API key (server-side only). Without it the chat shows a setup notice.
ANTHROPIC_API_KEY=
# Optional overrides
# ZECWISE_MODEL=claude-opus-5-5
# ZECWISE_ROUTER_MODEL=claude-opus-5-5
# ZECWISE_ANSWER_EFFORT=medium        # low | medium | high
# ZECWISE_JUDGE_MODEL=claude-opus-5-5  # eval suite judge

# ── Database (Supabase Postgres or any Postgres 15+ with pgvector) ───────
# Use the Supabase "Session pooler" or direct connection string.
DATABASE_URL=

# ── Admin sign-in ──────────────────────────────────────────────────────
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# ── Live web search (pick one) ─────────────────────────────────────────
TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SEARCH_PROVIDER=tavily               # tavily | brave (auto-detected from keys)

# ── Semantic search (optional; keyword search works without it) ─────────
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5

# ── Scheduled ingestion ────────────────────────────────────────────────
# Shared secret for /api/cron/ingest (sent as `Authorization: Bearer <secret>`)
CRON_SECRET=
# Optional: raises the GitHub API rate limit for release ingestion
# GITHUB_TOKEN=

# ── Tuning (optional) ──────────────────────────────────────────────────
# CHAT_RATE_LIMIT_PER_MINUTE=12
# INGEST_PER_HOST_DELAY_MS=1500
# INGEST_TIMEOUT_MS=20000
# ZECWISE_PRICE_OVERRIDES={"claude-opus-5-5":{"input":4,"output":20}}
